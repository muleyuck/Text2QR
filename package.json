{
  "name": "text2qr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "lint": "biome check .",
    "format": "biome check --write *",
    "prepare": "husky && wxt prepare"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check ."
    ]
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@tailwindcss/vite": "^4.1.16",
    "@types/chrome": "^0.1.27",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "husky": "^9.1.7",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "wxt": "^0.20.20"
  }
}
